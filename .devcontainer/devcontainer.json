{
  "name": "TraceForge",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install -e '.[dev]'",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "TraceForge", "onAutoForward": "openBrowser", "visibility": "private"}
  },
  "postStartCommand": "bash .devcontainer/start.sh"
}
